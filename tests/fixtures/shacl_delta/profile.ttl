# Synthetic profile shapes for tests/test_shacl_delta.py.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/profile#> .

ex:DatasetShape a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  sh:property [ sh:path dct:title ; sh:minCount 1 ; sh:nodeKind sh:Literal ] ;            # unchanged
  sh:property [ sh:path dct:issued ; sh:minCount 1 ; sh:maxCount 1 ] ;                    # tightened (minCount)
  sh:property [ sh:path dct:accrualPeriodicity ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;   # tightened (nodeKind)
  sh:property [ sh:path dct:bibliographicCitation ; sh:minCount 1 ; sh:datatype xsd:string ] ;  # added
  sh:property [ sh:path ex:sampleSize ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:severity sh:Info ] ;  # added, minted
  sh:property [ sh:path dcat:keyword ; sh:nodeKind sh:Literal ; sh:severity sh:Info ] ;  # loosened (severity)
  sh:property [ sh:path [ sh:inversePath dct:isPartOf ] ; sh:minCount 1 ] .               # unhandled path

ex:DistributionShape a sh:NodeShape ;
  sh:targetClass dcat:Distribution ;
  sh:property [ sh:path dct:format ; sh:in ( <http://example.org/f/csv> ) ] ;             # tightened (in)
  sh:property [ sh:path dct:license ; sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ] .  # added, sh:or reported

ex:AssessmentShape a sh:NodeShape ;
  sh:targetClass ex:Assessment ;
  sh:property [ sh:path dct:date ; sh:minCount 1 ; sh:severity sh:Warning ] .             # class addition + added

ex:NestedShape a sh:NodeShape ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ] .                                # no targetClass
